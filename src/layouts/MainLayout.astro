---
import Footer from '../components/Footer.astro';
import { SEO } from 'astro-seo';
import '@fontsource/poppins';
import Favicons from '../components/Favicons.astro';
import WorldsSponsor from '../components/WorldsSponsor.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { ClientRouter } from 'astro:transitions';
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <SEO
      title={title}
      description="The official website for the Knight Owls FIRST robotics team from Toronto, Canada"
      extend={{
        // extending the default link tags
        link: [{ rel: 'icon', href: '/favicon.ico' }],
        // extending the default meta tags
        meta: [
          {
            name: 'viewport',
            content: 'width=device-width, initial-scale=1.0',
          },
          { name: 'theme-color', content: '#5ccbff' },
          {
            name: 'twitter:image',
            content: 'https://knightowls.ca/images/people/placeholder.webp',
          },
        ],
      }}
      openGraph={{
        basic: {
          title: 'The Knight Owls',
          type: 'website',
          image: '/favicon.ico',
          url: 'https://knightowls.ca',
        },
        optional: {
          description:
            'The official website for the Knight Owls FIRST robotics team from Toronto, Canada',
        },
        image: {
          width: 1200,
          height: 630,
          alt: "An owl standing on a tree branch at night wearing a knight's helmet",
        },
      }}
    />
    <Favicons />
    <SpeedInsights />
    <link rel="stylesheet" href="/css/mobile.css" />
    <link rel="stylesheet" href="/css/aos.css" />
  </head>
  <body>
