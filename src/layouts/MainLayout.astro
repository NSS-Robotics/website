    <WorldsSponsor />
    <slot />
    <Footer />
    <style>
      :root {
        --button: #f2f2f2;
        --onyx: #282828;
        --blue: #707cac;
        --background: #ffffff;
        --text: #000000;
        --footerbutton: #b0b0b0;
      }
      .dark-mode {
        --button: #192331;
        --onyx: #141c27;
        --blue: #707cac;
        --background: #1f2b3d;
        --text: #ffffff;
        --footerbutton: #192331;
      }
      /* Entire Scrollbar */
      ::-webkit-scrollbar {
        width: 15px;
      }
      /* Draggy Thingy */
      ::-webkit-scrollbar-thumb {
        background: var(--onyx);
      }
      html,
      body {
        margin: 0;
        padding: 0;
        scroll-behavior: smooth;
        font-family: 'Poppins', sans-serif;
        overflow-x: hidden;
        background-color: var(--background);
        transition-duration: 0.3s;
      }
      .header {
        background-repeat: no-repeat !important;
        background-position: center !important;
        background-size: cover !important;
        width: 100%;
        height: 100vh;
        margin-top: auto;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-flow: column;
      }
    </style>
    <script defer src="/_vercel/insights/script.js"></script>
    <script is:inline src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script is:inline src="/src/js/darkMode.ts"></script>
    <script is:inline>
      AOS.init({
        duration: 600,
        delay: 100,
        once: true,
        offset: 50,
      });
    </script>
    <script is:inline>
      document.addEventListener('astro:after-swap', AOS.init);
    </script>
  </body>
</html>
