---
import { Icon } from 'astro-icon/components';
const currentYear = new Date().getFullYear();
---

<div class="footer">
  <div class="center">
    <div class="footerlinks">
      <a href="https://github.com/NSS-Robotics/" target="_blank">
        <Icon name="bi:github" />
      </a>
      <a href="https://www.instagram.com/knightowls_8884/" target="_blank">
        <Icon name="bi:instagram" />
      </a>
      <a href="https://www.youtube.com/@knightowls/" target="_blank">
        <Icon name="ri:youtube-fill" />
      </a>
      <a href="mailto:hello@knightowls.ca">
        <Icon name="bi:envelope" />
      </a>
    </div>
    <div class="pages">
      <a href="/">Home</a>
      <a href="/about">About Us</a>
      <a href="/gallery">Gallery</a>
      <a href="/sponsors">Our Sponsors</a>
      <a href="/tiers">Sponsorship Tiers</a>
      <a href="/donate">Sponsor Us</a>
      <label class="switch">
        <input type="checkbox" id="dark-mode-button">
        <span class="slider round"></span>
      </label>
    </div>
    <div class="footerline"></div>
    <div>
      <p>&copy; Knight Owls {currentYear}</p>
    </div>
    <div class="vercel">
      <p>Powered By</p>
      <a href="https://vercel.com/?utm_source=nssrobotics&utm_campaign=oss"
        ><img src="/images/vercel.svg" alt="Vercel logo" />
      </a>
    </div>
    <div class="moi">
      <a target="_blank" href="https://github.com/Orbitally"
        >Made with ❤️ by Jacob</a
      >
    </div>
  </div>
</div>
<style>
  /* Slider */
  /* The switch - the box around the slider */
.switch {
  position: relative;
  display: inline-block;
  width: 60px;
  height: 34px;
  margin-left: 8px;
  margin-right: 8px;
}
/* Hide default HTML checkbox */
.switch input {
  opacity: 0;
  width: 0;
  height: 0;
}
.slider {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--button);
  -webkit-transition: .4s;
  transition: .4s;
}
.slider:before {
  position: absolute;
  font-weight: bold;
  font-family: 'Poppins', sans-serif;
  content: "🌙";
  align-items: center;
  color: transparent;
  text-shadow: 0 0 0 var(--text);
  height: 26px;
  width: 26px;
  left: 4px;
  bottom: 4px;
  background-color: var(--background);
  -webkit-transition: .4s;
  transition: .4s;
}
input:checked + .slider {
  background-color: var(--blue);
}
input:focus + .slider {
  box-shadow: 0 0 1px var(--blue);
}
input:checked + .slider:before {
  -webkit-transform: translateX(26px);
  -ms-transform: translateX(26px);
  transform: translateX(26px);
  /* optional: content: "🔆";*/
}
/* Slider Rounding */
.slider.round {
  border-radius: 34px;
}
.slider.round:before {
  border-radius: 50%;
}

  .footer {
    background-color: var(--onyx);
    color: white;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-top: 50px;
    text-align: center;
    z-index: 1;
  }
  [data-icon] {
    color: white;
    width: 30px;
    height: auto;
    margin-left: 10px;
    transition-duration: 0.3s;
  }
  [data-icon]:hover {
    color: var(--blue);
    transition-duration: 0.3s;
  }
  .footer img {
    width: 80px;
    margin-bottom: 15px;
    margin-left: 10px;
  }
  .vercel {
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  .vercel p {
    margin-bottom: 7px;
  }
  .vercel img {
    margin-bottom: 2px;
  }
  .moi {
    margin-top: 0px;
  }
  .moi a {
    color: white;
    text-decoration: underline solid transparent;
    transition-duration: 0.3s;
    font-size: 13px;
  }
  .moi a:hover {
    text-decoration: underline solid white;
    transition-duration: 0.3s;
  }
  .center {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  .center p {
    font-size: 18px;
    margin-top: 0px;
  }
  .footerline {
    height: 2px;
    width: 30%;
    background-color: white;
    margin-bottom: 20px;
  }
  .footerlinks {
    margin-top: 12px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: row;
  }
  .icons {
    color: #ffffff;
    font-size: 27px;
    padding: 5px;
    transition-duration: 0.3s;
  }
  .pages {
    margin-bottom: 15px;
    align-items: center;
    display: flex;
  }
  .pages a {
    margin-left: 8px;
    margin-right: 8px;
    color: white;
    text-decoration: none;
    transition-duration: 0.3s;
    text-decoration: underline solid transparent;
  }
  .pages a:hover {
    text-decoration: underline solid var(--blue);
    text-decoration-thickness: 2px;
    transition-duration: 0.3s;
  }
</style>
