---
const { image, text, color, year } = Astro.props;
---

<li class={color + " banner"}>
  <img src={image} alt="Award Icon" />
  <div class="txt">
    {year}
    {text}
  </div>
</li>

<style>
  /* Created by Erik Boesen with FIRST Robotics Competition Team 1418.
    Offered under the MIT License. */
  .banner {
    margin: 0;
    padding: 0;
    box-sizing: border-box;

    line-height: 1.2;
    font-family: "Poppins", sans-serif;
    text-align: center;
    vertical-align: top;
    display: inline-block;
    margin: 0 3px 30px;
    width: 120px;
    min-height: 160px;
    position: relative;
    background: #0f4bcb; /* #0f4bcb for blue #777 for grey */
    color: white;
    padding: 10px;
    white-space: normal;
  }
  .banner img {
    width: 75px;
    margin-bottom: 5px;
  }
  .banner:after {
    content: "";
    position: absolute;
    display: block;
    border: 60px solid #0f4bcb;
    border-top-width: 5px;
    border-bottom: 20px transparent solid;
    top: 100%;
    left: 0;
  }
  .banner,
  .banner:after {
    -webkit-filter: drop-shadow(0 10px 5px rgba(0, 0, 0, 0.1));
    filter: drop-shadow(0 10px 5px rgba(0, 0, 0, 0.1));
  }
  .grey {
    background: #777 !important;
  }
  .grey:after {
    border-color: #777 !important;
    border-bottom-color: transparent !important;
  }
  .txt {
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }
</style>
