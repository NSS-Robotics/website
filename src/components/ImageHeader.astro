---
import Navbar from './Navbar.astro';
import ScrollDown from './ScrollDown.astro';

import { contentfulClient } from '../lib/contentful';

const { page } = Astro.props;

interface ImageHeader {
  fields: {
    title: string;
    subtitle: string;
    image: {
      fields: {
        file: {
          url: string;
        };
      };
    };
    page: string;
  };
  contentTypeId: string;
}

const ImageHeaderResponse = await contentfulClient.getEntries<ImageHeader>({
  content_type: 'header',
  'fields.page[match]': `${page}`,
});

const { title, subtitle, image } = ImageHeaderResponse.items[0].fields;
---

<div class="header">
  <Navbar />
  <div class="black"></div>
  <div
    class="titles"
    data-aos-delay="800"
    data-aos-duration="800"
    data-aos="fade-up"
  >
    <h1>{title}</h1>
    <p class="subtitle">{subtitle}</p>
  </div>
  <ScrollDown />
  <!-- Image background for the header -->
  <img src=`${image.fields.file.url}?fm=webp&q=10` />
</div>

<style>
  @media screen and (max-width: 813px) {
    .header {
      background-repeat: no-repeat;
      background-position: center;
      width: 100vw !important;
    }
    .black {
      background-repeat: no-repeat;
      background-position: center;
      width: 100vw !important;
    }
  }
  .header {
    width: auto;
    height: 100vh;
    margin-top: auto;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-flow: column;
  }
  .titles {
    font-size: 30px;
    color: white;
    text-align: center;
    text-decoration: underline;
    text-decoration-color: var(--blue);
    margin-bottom: 20%;
    margin-top: 20%;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
    z-index: 2;
  }
  /* Mini Subtitle Text */
  .subtitle {
    font-size: 25px;
  }
  .black {
    background: black;
    opacity: 50%;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 1;
  }
  img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    object-fit: cover;
    z-index: 0;
  }
</style>
