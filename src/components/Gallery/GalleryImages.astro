---
//@ts-ignore
import { Picture } from "astro:assets";

const { images = [] } = Astro.props;
---

{
  images.map((image: string) => (
    <div class="galleryImage" data-aos="fade-up">
      <img src={image} alt="An image in the gallery" />
    </div>
  ))
}
<style>
  img {
    width: 100%;
    height: auto;
  }
  .galleryImage {
    width: 90%;
    height: auto;
    padding-top: 1%;
    padding-bottom: 1%;
    align-self: center;
    justify-self: center;
  }
</style>
