<style>
  @media screen and (max-width: 1100px) {
    .navbar {
      flex-wrap: wrap;
      position: absolute;
    }
  }
  @media screen and (max-width: 845px) {
    .navbar {
      transform: scale(0.9) !important;
      flex-wrap: wrap;
      position: absolute;
      top: 2%;
    }
    .space {
      display: none;
    }
  }
  @media screen and (max-width: 482px) {
    .navbar {
      transform: scale(0.8) !important;
    }
  }
  /* Main Navbar Div */
  .navbar {
    display: flex;
    justify-content: center;
    align-items: center;
    /*padding-top: 5vh;*/
    z-index: 10;
    position: absolute;
    top: 0;
  }
  .left {
    display: flex;
    color: white;
    font-size: large;
  }
  .right {
    display: flex;
    flex-flow: wrap;
    align-content: center;
    justify-content: center;
    row-gap: 20px;
  }
  #logo {
    width: 50px;
  }
  .space {
    width: 13vw;
  }
  .left img {
    width: 10%;
    height: 10%;
    align-self: center;
    padding-right: 10px;
  }
  /* Navbar Button */
  .dropbtn {
    text-decoration: none;
    color: white;
    text-decoration: underline solid transparent;
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 10px;
    padding-bottom: 10px;
    font-size: 18px;
    border: none;
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition-duration: 0.3s;
  }
  .dropbtn:hover {
    text-decoration: underline solid var(--blue);
    text-decoration-thickness: 2px;
    transition-duration: 0.3s;
  }
  /* The container <div> - needed to position the dropdown content */
  .dropdown {
    position: relative;
    display: inline-block;
    align-self: center;
  }
  /* Dropdown Content (Hidden by Default) */
  .dropdown-content {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    min-width: 160px;
    z-index: 1;
    background-color: #efefef;
    text-align: center;
    margin-top: 8px;
    border-radius: 8px;
    transition: 0.3s;
  }
  /* Links Inside The Dropdown Content */
  .dropdown-content a:hover {
    text-decoration: underline solid var(--blue);
    transition-duration: 0.6s;
  }
  /* Links inside the dropdown */
  .dropdown-content a {
    color: black;
    padding: 12px 16px;
    text-decoration: none;
    display: block;
    border-radius: 10px;
    text-decoration: underline solid transparent;
  }
  /* Show the dropdown menu on hover */
  .dropdown:hover .dropdown-content {
    display: block;
    opacity: 1;
    pointer-events: auto;
    transition-duration: 0.3s;
  }

  /* show dropdown on mobile when toggled */
  .dropdown.open .dropdown-content {
      display: block;
      opacity: 1;
      pointer-events: auto;
  }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const isMobile = () => window.matchMedia('(max-width: 845px)').matches;
        const dropdowns = Array.from(document.querySelectorAll('.dropdown'))
            .filter(d => d.querySelector('.dropdown-content'));

        dropdowns.forEach(drop => {
            const btn = drop.querySelector('.dropbtn');
            if (!btn) return;
            btn.setAttribute('aria-haspopup', 'true');
            btn.setAttribute('aria-expanded', 'false');

            btn.addEventListener('click', (e) => {
                if (!isMobile()) return; // keep normal behavior on desktop

                // check if the button is already expanded; if so, allow navigation
                const isExpanded = btn.getAttribute('aria-expanded') === 'true';
                if (isExpanded) {
                    // let the link follow its href on the second tap
                    return;
                }

                // first tap on mobile: prevent navigation and open the menu
                e.preventDefault();
                const opened = drop.classList.toggle('open');
                btn.setAttribute('aria-expanded', String(opened));

                // close others
                dropdowns.forEach(other => {
                    if (other !== drop && other.classList.contains('open')) {
                        other.classList.remove('open');
                        const ob = other.querySelector('.dropbtn');
                        if (ob) ob.setAttribute('aria-expanded', 'false');
                    }
                });
            });
        });

        // close on outside tap (mobile)
        document.addEventListener('click', (e) => {
            if (!isMobile()) return;
            // safe composedPath usage for TypeScript environments
            const path = (typeof (e as any).composedPath === 'function') ? (e as any).composedPath() : [];
            dropdowns.forEach(drop => {
                if (!drop.classList.contains('open')) return;
                if (!path.includes(drop)) {
                    drop.classList.remove('open');
                    const b = drop.querySelector('.dropbtn');
                    if (b) b.setAttribute('aria-expanded', 'false');
                }
            });
        });

        // escape closes any open dropdown
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                dropdowns.forEach(drop => {
                    if (drop.classList.contains('open')) {
                        drop.classList.remove('open');
                        const b = drop.querySelector('.dropbtn');
                        if (b) b.setAttribute('aria-expanded', 'false');
                    }
                });
            }
        });
    });
</script>

