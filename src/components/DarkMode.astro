---
import { Icon } from 'astro-icon/components';
---

<div class="darkmodetoggle">
  <Icon name="bi:sun-fill" />
  <label class="switch">
    <input type="checkbox" id="dark-mode-button" />
    <span class="slider round"></span>
  </label>
  <Icon name="bi:moon-fill" />
</div>

<script>
  const darkModeSwitch = document.getElementById('dark-mode-button');

  // Listen for the dark mode toggle button click
  darkModeSwitch?.addEventListener('click', toggleDarkMode);

  // Check the current theme on page load
  window.onload = () => {
    if (localStorage.getItem('dark-mode') === 'true') {
      document.querySelector('body')?.classList.add('dark-mode');
      darkModeSwitch.checked = true;
    } else {
      document.querySelector('body')?.classList.remove('dark-mode');
      darkModeSwitch.checked = false;
    }
  };

  // Listen for the "astro:before-swap" event to make sure the incoming page has the correct theme
  document.addEventListener('astro:before-swap', (event) => {
    if (localStorage.getItem('dark-mode') === 'true') {
      event.newDocument.querySelector('body')?.classList.add('dark-mode');
      darkModeSwitch.checked = true;
    } else {
      event.newDocument.querySelector('body')?.classList.remove('dark-mode');
      darkModeSwitch.checked = false;
    }
  });

  // Toggle dark mode variable in local storage when button is clicked
  function toggleDarkMode() {
    if (localStorage.getItem('dark-mode') === 'true') {
      localStorage.setItem('dark-mode', 'false');
      document.querySelector('body')?.classList.remove('dark-mode');
    } else {
      localStorage.setItem('dark-mode', 'true');
      document.querySelector('body')?.classList.add('dark-mode');
    }
  }
</script>
<style>
  /* Slider */
  /* The switch - the box around the slider */
  .switch {
    position: relative;
    display: inline-block;
    width: 60px;
    height: 34px;
    margin-left: 8px;
    margin-right: 8px;
  }
  /* Hide default HTML checkbox */
  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--footerbutton);
    -webkit-transition: 0.4s;
    transition: 0.4s;
  }
  .slider:before {
    position: absolute;
    font-weight: bold;
    font-family: 'Poppins', sans-serif;
    content: '';
    /* content: "🌙"; */
    align-items: center;
    color: transparent;
    text-shadow: 0 0 0 var(--text);
    height: 26px;
    width: 26px;
    left: 4px;
    bottom: 4px;
    background-color: var(--background);
    -webkit-transition: 0.4s;
    transition: 0.4s;
  }
  input:checked + .slider {
    background-color: var(--blue);
  }
  input:focus + .slider {
    box-shadow: 0 0 1px var(--blue);
  }
  input:checked + .slider:before {
    -webkit-transform: translateX(26px);
    -ms-transform: translateX(26px);
    transform: translateX(26px);
    /* optional: content: "🔆";*/
  }
  /* Slider Rounding */
  .slider.round {
    border-radius: 34px;
  }
  .slider.round:before {
    border-radius: 50%;
  }

  /* div */
  .darkmodetoggle {
    margin-bottom: 15px;
    align-items: center;
    display: flex;
  }
  .darkmodetoggle svg {
    margin-top: 12px;
    margin-bottom: 12px;
    margin-left: 8px;
    margin-right: 8px;
    font-size: 16px;
  }
</style>
