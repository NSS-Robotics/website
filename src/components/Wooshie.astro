---
import { Image } from 'astro:assets';

const {
  fadeDirection = 'left',
  title,
  subtitle,
  image,
  alt,
  buttonLink,
  buttonText,
} = Astro.props;
---

<div class="woosh" data-aos={'fade-' + fadeDirection}>
  <div class="wooshgroup">
    <h2>{title}</h2>
    <p>{subtitle}</p>
    <a href={buttonLink}>{buttonText}</a>
  </div>
  <Image
    data-aos={'fade-' + fadeDirection}
    src={image}
    width={600}
    height={350}
    alt={alt}
  />
</div>
<style>
  img {
    padding: 15px;
    border-radius: 30px;
  }
  p {
    padding-left: 15px;
    padding-right: 15px;
    margin-bottom: 10%;
    width: 300px;
  }
  a {
    text-decoration: none;
    color: var(--text);
    background-color: var(--button);
    margin-top: 30px;
    padding-left: 17px;
    padding-right: 17px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-radius: 10px;
    transition-duration: 200ms;
    border: 3px solid var(--button);
  }
  a:hover {
    transition-duration: 200ms;
    background-color: transparent;
    color: var(--blue);
    border: 3px solid var(--blue);
  }
  .wooshgroup {
    text-align: center;
    margin-top: auto;
    margin-bottom: auto;
  }
  h2 {
    text-decoration: underline;
    text-decoration-color: var(--blue);
  }
  .woosh {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    margin-top: 50px;
    width: 75vw;
  }
</style>
