---
import { Image } from 'astro:assets';

const { name, title, image = `/images/people/placeholder.webp` } = Astro.props;
---

<div>
  <Image
    data-aos="zoom-in-up"
    src={image}
    width={300}
    height={300}
    data-aos-once="true"
    alt={name}
  />
  <p>{name}</p>
  <p class="title">{title}</p>
</div>
<style>
  img {
    height: 300px;
    width: 300px;
    border-radius: 50%;
  }
  p {
    text-align: center;
    font-weight: bold;
    margin-bottom: 0;
    font-size: 20px;
  }
  .title {
    font-size: 20px;
    font-weight: lighter;
    text-align: center;
    width: 300px;
  }
</style>
