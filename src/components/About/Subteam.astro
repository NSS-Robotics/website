---
import { Image } from 'astro:assets';

const { name, alt, description, image, fadeDirection } = Astro.props;
---

<div class="teamgroup">
  <div>
    <Image
      data-aos={'fade-' + fadeDirection}
      src={image}
      width={550}
      height={420}
      alt={alt}
    />
  </div>
  <div>
    <h3>{name}</h3>
    <p>
      {description}
    </p>
  </div>
</div>
<style>
  .teamgroup {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  img {
    border-radius: 10px;
    float: left;
    left: 0;
  }
  p {
    text-align: center;
    font-size: 20px;
    padding-left: 15%;
    padding-right: 15%;
  }
  h3 {
    text-align: center;
    text-decoration: none;
    font-size: 30px;
    margin-top: 0;
    margin-bottom: 0;
    text-decoration: underline;
    text-decoration-color: var(--blue);
  }
</style>
