---
import { contentfulClient } from '../lib/contentful';
import MainLayout from '../layouts/MainLayout.astro';
import ImageHeader from '../components/ImageHeader.astro';
import AboutUsItem from '../components/About/AboutUsItem.astro';
import Subteam from '../components/About/Subteam.astro';
import YearSelector from '../components/About/YearSelector.astro';
import Roster from '../components/About/Roster.astro';

interface Subteams {
  fields: {
    subteamTitle: string;
    subteamDescription: string;
    subteamImage: {
      fields: {
        file: {
          url: string;
        };
      };
    };
    subteamImageAltText: string;
    order: number;
  };
  contentTypeId: string;
}
interface AboutUs {
  fields: {
    title: string;
    paragraph: string;
    image: {
      fields: {
        file: {
          url: string;
        };
      };
    };
    order: number;
    fadeDirection: string;
  };
  contentTypeId: string;
}

const aboutUsResponse = await contentfulClient.getEntries<AboutUs>({
  content_type: 'whoAreWe',
  //@ts-ignore
  order: '-fields.order',
});

const subteamResponse = await contentfulClient.getEntries<Subteams>({
  content_type: 'subteam',
  //@ts-ignore
  order: '-fields.order',
});
---

<MainLayout title="Knight Owls - About Us">
  <ImageHeader page="about" />
  <div class="content">
    <a id="whoarewe"></a>
    <div class="about-us">
      <!-- Map the about us response to the page -->
      {
        aboutUsResponse.items.map((item) => {
          return (
            <AboutUsItem
              title={item.fields.title}
              paragraph={item.fields.paragraph}
              image={`${item.fields.image.fields.file.url}?fm=avif&w=550&h=420`}
              alt={item.fields.title}
              fadeDirection={item.fields.fadeDirection}
            />
          );
        })
      }
    </div>
    <div id="teams" class="subteams" data-aos="zoom-in ">
      <h2>Our Subteams</h2>
    </div>
    <div class="teams">
      {
        subteamResponse.items.map((item) => {
          return (
            <Subteam
              name={item.fields.subteamTitle}
              image={`${item.fields.subteamImage.fields.file.url}?fm=avif&w=550&h=420`}
              alt={item.fields.subteamImageAltText}
              description={item.fields.subteamDescription}
              fadeDirection="left"
            />
          );
        })
      }
    </div>
    <h3 id="people" class="our-team" data-aos="zoom-in" data-aos-once="true">
      Our Members
    </h3>
    <YearSelector />
    <Roster />
  </div>
  <style>
    @media screen and (max-width: 813px) {
      .our-team {
        width: auto !important;
      }
      .about-us p {
        margin-right: 20px;
        margin-left: 20px;
      }
      .left {
        justify-content: center;
      }
    }
    @media screen and (max-width: 680px) {
      .about-us {
        margin-left: 20px !important;
        margin-right: 20px !important;
      }
      .teams {
        margin-left: 60px !important;
        margin-right: 60px !important;
      }
    }
    .content {
      line-height: 2;
      color: var(--text);
    }
    .about-us {
      display: grid;
      grid-template-rows: auto;
      align-items: start;
      justify-content: center;
      margin-top: 10%;
      gap: 50px;
      width: fit-content;
      color: var(--text);
      text-align: left;
      width: fit-content;
      margin-left: 100px;
      margin-right: 100px;
    }

    .subteams {
      margin-top: 10%;
      text-align: center;
    }
    .subteams h3 {
      font-size: 32px;
      text-decoration: underline;
      text-decoration-color: var(--blue);
      color: var(--text);
    }
    .subteams h2 {
      font-size: 42px;
      text-decoration: underline;
      text-decoration-color: var(--blue);
      color: var(--text);
    }
    .subteams p {
      font-size: 20px;
      padding-left: 50px;
      padding-right: 50px;
      color: var(--text);
    }
    .teams {
      display: grid;
      grid-template-columns: auto;
      gap: 50px;
      align-items: center;
      justify-content: center;
      color: var(--text);
      margin-top: 4%;
      margin-left: 100px;
      margin-right: 100px;
    }
    .our-team {
      display: block;
      text-align: center;
      font-size: 50px;
      margin-top: 8%;
      margin-bottom: 0;
      text-decoration: underline;
      text-decoration-color: var(--blue);
      color: var(--text);
    }
  </style>
</MainLayout>
