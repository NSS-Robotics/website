---
import MainLayout from "../layouts/MainLayout.astro";
import ImageHeader from "../components/ImageHeader.astro";
import GalleryVideos from "../components/Gallery/GalleryVideos.astro";
---

<MainLayout title="Knight Owls - Donate">
  <ImageHeader page="donate" />
  <div class="content">
    <div class="things">
      <div class="iframe-container" data-aos="fade-left">
        <iframe
          src="https://www.canadahelps.org/en/dne/m/10652/donation"
          title="iframe"
          width="100%"
          allow="payment"
          style="border: none; overflow: hidden;"></iframe>
      </div>
      <div class="info" data-aos="fade-right">
        <h2>Donating</h2>
        <p>
          We process all donations with the help of the Northern Secondary
          School Foundation (NSSF). The NSSF is a registered charity with the
          CRA meaning that all donations over $20 are eligible for a tax
          receipt.<br /><br />
          When using the donation form, please make sure you include <strong
            >your name</strong
          > and <strong>"NSS Robotics Team"</strong> in the <strong
            >private message field</strong
          >
          so that your donation is sent to the Robotics Team as opposed to one of
          the other initiatives that the NSSF supports.<br /><br />Please take a
          quick look at the <a href="/tiers#listing">sponsorship tiers</a>
          for more info on the perks you'll receive with your donation. If you have
          any questions, don't hesitate to
          <a href="mailto:hello@knightowls.ca">get in touch!</a>
        </p>
        <GalleryVideos videoids={["6_lIajaufcI"]} />
      </div>
    </div>
  </div>
  <style>
    @media screen and (max-width: 1200px) {
      .things {
        grid-template-columns: 100% !important;
      }
    }
    @media screen and (max-width: 610px) {
      iframe {
        width: 90% !important;
      }
    }

    .content {
      margin-top: 25px;
      line-height: 2;
    }
    .things {
      display: grid;
      grid-template-columns: 28% 50%;
      justify-content: center;
      align-content: center;
      padding: 15px;
    }
    .info {
      display: flex;
      flex-direction: column;
      justify-content: center;
      justify-self: center;
      align-items: center;
      width: 90%;
    }
    .iframe-container {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    strong {
      color: var(--blue);
    }
    h2 {
      text-align: center;
      text-decoration: underline;
      text-decoration-color: var(--blue);
      font-size: 35px;
      color: var(--text);
    }
    p {
      width: 85%;
      text-align: center;
      color: var(--text);
    }
    a {
      color: var(--blue);
      transition-duration: 0.3s;
    }
    a:hover {
      color: var(--onyx);
      transition-duration: 0.3s;
    }
    iframe {
      border-radius: 10px;
      width: 450px;
      height: 780px;
    }
  </style>
</MainLayout>
