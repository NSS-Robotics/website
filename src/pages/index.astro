---
import { contentfulClient } from '../lib/contentful';

import MainLayout from '../layouts/MainLayout.astro';
import ImageHeader from '../components/ImageHeader.astro';
import Wooshie from '../components/Wooshie.astro';

interface Wooshie {
  fields: {
    title: string;
    description: string;
    image: {
      fields: {
        file: {
          url: any;
        };
      };
    };
    imageAltText: string;
    buttonText: string;
    buttonLink: string;
    fadeDirection: string;
    order: number;
  };
  contentTypeId: string;
}

const aboutUsResponse = await contentfulClient.getEntries<Wooshie>({
  content_type: 'wooshies',
  //@ts-ignore
  order: '-fields.order',
});
---

<MainLayout title="Knight Owls - Home">
  <ImageHeader page="home" />
  <div class="wooshies">
    {
      aboutUsResponse.items.map((wooshie) => (
        <Wooshie
          fadeDirection={wooshie.fields.fadeDirection}
          title={wooshie.fields.title}
          subtitle={wooshie.fields.description}
          image={`${wooshie.fields.image.fields.file.url}?fm=avif&fit=fill&w=600`}
          alt={wooshie.fields.imageAltText}
          buttonLink={wooshie.fields.buttonLink}
          buttonText={wooshie.fields.buttonText}
        />
      ))
    }
  </div>
</MainLayout>
<style>
  .wooshies {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-top: 20px;
    background-color: var(--background);
    color: var(--text);
    transition-duration: 0.3s;
  }
</style>
